# Google Cloud Project ID (e.g. my-gcp-project-123456)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Vertex AI Gemini Region / Endpoint ('global' or e.g. 'us-central1')
GOOGLE_CLOUD_LOCATION=global

# Shared API secret expected in the X-API-Key request header
API_KEY=your-secure-random-api-key

# Allowed CORS origins (comma-separated). Set to frontend URL in production or * for development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Gemini model override (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
