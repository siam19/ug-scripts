# Telegram Bot API token from BotFather
BOT_TOKEN=your-telegram-bot-token

# Your Telegram numeric chat ID (obtained by sending /start to @ugscripts_notifications_bot)
ADMIN_CHAT_ID=123456789

# Secret key required in Authorization: Bearer <token> or X-Notify-Secret when calling POST /notify
NOTIFY_SECRET=replace-with-a-secure-random-secret

# Optional: Telegram Webhook secret token for X-Telegram-Bot-Api-Secret-Token
TELEGRAM_SECRET_TOKEN=optional-webhook-secret
