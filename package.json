{
  "name": "ug-script-writer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --filter web dev",
    "build:web": "bun --filter web build",
    "lint:web": "bun --filter web lint",
    "gen:types": "bun --filter api-types gen",
    "dev:bot": "bun --filter notifications-bot dev",
    "test:bot": "bun --filter notifications-bot test",
    "deploy:bot": "bun --filter notifications-bot deploy",
    "test:api": "cd apps/api && .venv/bin/pytest -v"
  }
}
