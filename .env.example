# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# Vertex AI Model Override (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Shared API Secret expected in X-API-Key header (for admin/CI bypass)
API_KEY=your-secure-random-api-key

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://localhost:8080

# Container & Service Port
PORT=8080

# Telegram Bot / Lead Notification Webhook
NOTIFY_WEBHOOK_URL=https://ugscripts-notifications-bot.<your-subdomain>.workers.dev/notify
NOTIFY_SECRET=your-secure-random-notify-secret
